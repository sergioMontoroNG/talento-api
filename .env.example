# App ya registrada en Microsoft Entra ID (Azure AD) que enviara los correos
# via Microsoft Graph (client credentials, sin SMTP). Necesita el permiso de
# aplicacion "Mail.Send" con consentimiento de administrador concedido.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Buzon desde el que salen ambos correos. Tiene que ser un buzon real del
# tenant (UPN completo, p. ej. rrhh@newgarden.es) y estar dentro del alcance
# que tenga permitido la app (todo el tenant, salvo que haya una Application
# Access Policy que lo restrinja a ciertos buzones).
MAIL_FROM=rrhh@newgarden.es

# Buzon interno que recibe el CV. Por defecto rrhh@newgarden.es si se deja vacio.
MAIL_TO=rrhh@newgarden.es

# Opcional: sobrescribe el asunto del correo de confirmacion al candidato
# (ver comentario en api/candidatura.js sobre el valor original de WordPress).
# MAIL_CANDIDATE_SUBJECT=

# Tamano maximo del CV en MB. Microsoft Graph limita los adjuntos enviados
# como contentBytes (base64) a 3MB una vez codificados, asi que el archivo
# original tiene que quedarse claramente por debajo de eso (ver comentario
# en api/candidatura.js). No subir este valor sin cambiar tambien el modo de
# adjuntar el archivo (upload session) si hiciera falta.
CV_MAX_SIZE_MB=2

# Dominios desde los que se acepta la peticion (CORS), separados por coma.
# Si se deja vacio se usa la lista por defecto de dominios de Newgarden
# definida en api/candidatura.js.
# ALLOWED_ORIGINS=https://newgarden.es,https://newgardenshop.es
